# =============================================================================
# Переменные окружения для чат-бота «Алина» (VK + GigaChat).
# Скопируйте этот файл в .env и заполните реальными значениями.
# Файл .env в Git не попадает (см. .gitignore).
# =============================================================================

# --- ВКонтакте ---------------------------------------------------------------
# Токен доступа сообщества (group token) с правом доступа к сообщениям.
# Как получить: VK → Управление сообществом → Настройки → Работа с API →
#   «Ключи доступа» → «Ключ доступа сообщества» (включить права: сообщения).
VK_GROUP_TOKEN=

# Версия API ВКонтакте (по умолчанию 5.199).
#VK_API_VERSION=5.199

# Таймаут ожидания событий Long Poll в секундах (по умолчанию 25).
#VK_LONGPOLL_WAIT=25

# --- GigaChat ----------------------------------------------------------------
# Ключ авторизации GigaChat (Authorization Key) из личного кабинета Studio →
#   Проект GigaChat API → Настройки API → «Получить ключ».
# Показывается только один раз, храните надёжно.
GIGACHAT_AUTH_KEY=

# Область доступа: GIGACHAT_API_PERS — физлица,
#   GIGACHAT_API_B2B / GIGACHAT_API_CORP — ИП и юрлица.
#GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель GigaChat: GigaChat-2, GigaChat-2-Pro, GigaChat-2-Max, GigaChat-3-Ultra.
#GIGACHAT_MODEL=GigaChat-2-Pro

# Базовый адрес API (по умолчанию https://api.giga.chat/v1).
#GIGACHAT_API_BASE=https://api.giga.chat/v1

# Эндпоинт получения access-токена (отдельный сервер авторизации).
#GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Путь к файлу корневого сертификата Минцифры, если возникают SSL-ошибки.
#GIGACHAT_CA_BUNDLE_PATH=

# Проверка SSL-сертификата. false — только для локальных тестов!
#GIGACHAT_VERIFY_SSL=true

# Максимум токенов в одном ответе модели (по умолчанию 1200).
#GIGACHAT_MAX_TOKENS=1200

# --- Поведение бота ----------------------------------------------------------
# Сколько последних сообщений диалога помнить (на собеседника, по умолчанию 12).
#MAX_HISTORY_MESSAGES=12

# Максимальная длина одного исходящего сообщения ВК (лимит ВК — 4096).
#MAX_REPLY_LENGTH=3800

# Режим базы знаний: пусто/0 — всегда подставлять базу целиком;
# число N — подставлять только N наиболее релевантных секций по запросу.
#KNOWLEDGE_TOP_K=

# Директория с markdown-файлами базы знаний (по умолчанию knowledge_base/).
#KNOWLEDGE_DIR=
